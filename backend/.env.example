# Server
PORT=4000
NODE_ENV=development
BACKEND_URL="http://localhost:4000"

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/discovery_cappadocia?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="change-me-to-a-strong-random-secret-in-production"
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# iyzico
IYZICO_API_KEY="sandbox-..."
IYZICO_SECRET_KEY="sandbox-..."
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"
IYZICO_DEFAULT_IDENTITY_NUMBER="11111111111"
IYZICO_DEFAULT_ADDRESS="Cappadocia, Turkey"

# Cloudinary (server-side secrets; never expose these as NEXT_PUBLIC_*)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
CLOUDINARY_FOLDER="discovery-cappadocia/tours"
MAX_IMAGE_UPLOAD_MB=8
ALLOWED_MEDIA_HOSTS="res.cloudinary.com"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"
FRONTEND_URLS="http://localhost:3000"

# Email (Resend — https://resend.com). New-reservation notifications are sent
# to ADMIN_NOTIFICATION_EMAIL as soon as a guest books. Leave RESEND_API_KEY
# unset to disable email sending (it will just log a warning instead).
RESEND_API_KEY=""
MAIL_FROM="Kapadokya Travel <info@kapheratravel.com>"
ADMIN_NOTIFICATION_EMAIL="info@kapheratravel.com"

# One-time secure admin provisioning (npm run admin:create)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-random-12-plus-character-password"
ADMIN_NAME="Administrator"
ADMIN_PHONE=""

# Seed is blocked in production unless this explicit emergency switch is set.
ALLOW_PRODUCTION_SEED=false
